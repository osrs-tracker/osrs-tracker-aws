{
  "name": "@osrs-tracker/models",
  "version": "2.2.0",
  "description": "Typings for OSRS Tracker API",
  "license": "Apache-2.0",
  "author": "Freek Mencke",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osrs-tracker/osrs-tracker-aws.git",
    "directory": "@osrs-tracker/models"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs",
    "build:esm": "tsc --module ESNext --outDir dist/esm && echo '{ \"type\": \"module\" }' > dist/esm/package.json",
    "build:types": "tsc --declaration --declarationMap --emitDeclarationOnly --outDir dist/types",
    "prepublishOnly": "npm run build",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "mongodb": "^7.7.0",
    "mongodb-memory-server": "^10.4.3",
    "typescript": "5.8.2",
    "vitest": "^5.0.3"
  }
}

{
  "name": "@osrs-tracker/hiscores",
  "version": "4.1.0",
  "description": "Helpers for OSRS hiscores: a hiscore client, skill and activity names, snapshot diffs and XP",
  "license": "Apache-2.0",
  "author": "Freek Mencke",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/types/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osrs-tracker/osrs-tracker-aws.git",
    "directory": "@osrs-tracker/hiscores"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module CommonJS --outDir dist/cjs",
    "build:esm": "tsc --module ESNext --outDir dist/esm && echo '{ \"type\": \"module\" }' > dist/esm/package.json",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist/types",
    "prepublishOnly": "npm run build",
    "test": "jest --watch"
  },
  "peerDependencies": {
    "@osrs-tracker/models": "^2.1.0"
  },
  "devDependencies": {
    "@osrs-tracker/models": "^2.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.6",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "typescript": "^5.8.3"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}

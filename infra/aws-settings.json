{
  "alarms": {
    "osrs-tracker_alarm-to-discord-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_alarm-to-discord"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 3600,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_clean-hiscores-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_clean-hiscores"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 86400,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_hiscore-proxy-requests": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "The hiscore proxy got 1,500+ requests in 5 minutes (normal peak: about 500, around 00:00 UTC): someone may be using it as a relay. See INFRA.md, CloudWatch alarms",
      "dimensions": {
        "Api": "OSRS Tracker API",
        "Stage": "$default"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Count",
      "namespace": "AWS/ApiGateway",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 300,
      "statistic": "Sum",
      "threshold": 1500.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_process-players-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_process-players"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 3600,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_process-players-failed-events": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "A process-players event failed all 3 attempts or waited over 1 hour in Lambda's queue: its players missed today's scrape. See INFRA.md, Schedules and async invokes",
      "dimensions": {
        "QueueName": "osrs-tracker_players-to-scrape-dead"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "ApproximateNumberOfMessagesVisible",
      "namespace": "AWS/SQS",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 300,
      "statistic": "Maximum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_queue-players-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_queue-players"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 3600,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_record-player-count-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_record-player-count"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 600,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    },
    "osrs-tracker_refresh-items-errors": {
      "actionsEnabled": true,
      "alarmActions": [
        "osrs-tracker-alerts"
      ],
      "comparison": "GreaterThanOrEqualToThreshold",
      "datapointsToAlarm": null,
      "description": "Failed (error, timeout or out of memory): read its latest log stream",
      "dimensions": {
        "FunctionName": "osrs-tracker_refresh-items"
      },
      "evaluationPeriods": 1,
      "insufficientDataActions": [],
      "metric": "Errors",
      "namespace": "AWS/Lambda",
      "okActions": [
        "osrs-tracker-alerts"
      ],
      "periodSeconds": 3600,
      "statistic": "Sum",
      "threshold": 1.0,
      "treatMissingData": "notBreaching"
    }
  },
  "httpApis": {
    "OSRS Tracker API": {
      "cors": {
        "AllowCredentials": false,
        "AllowHeaders": [
          "*"
        ],
        "AllowMethods": [
          "*"
        ],
        "AllowOrigins": [
          "http://localhost:4200",
          "https://osrs-tracker.freekmencke.com"
        ],
        "ExposeHeaders": [
          "*"
        ],
        "MaxAge": 86400
      },
      "description": "RuneScape reverse proxy + OSRS Tracker calls.",
      "disableExecuteApiEndpoint": false,
      "domains": [
        {
          "domain": "runescape-api.freekmencke.com",
          "endpointType": "REGIONAL",
          "mappingKey": "",
          "securityPolicy": "TLS_1_2",
          "stage": "$default"
        }
      ],
      "name": "OSRS Tracker API",
      "protocol": "HTTP",
      "routes": [
        {
          "apiKeyRequired": false,
          "authorization": "NONE",
          "integration": {
            "connectionType": "INTERNET",
            "method": "ANY",
            "payloadFormatVersion": "1.0",
            "requestParameterNames": [],
            "responseParameters": {
              "200": {
                "overwrite:header.X-Robots-Tag": "noindex"
              }
            },
            "timeoutMs": 30000,
            "type": "HTTP_PROXY",
            "uri": "https://secure.runescape.com/{proxy}"
          },
          "routeKey": "ANY /rs/{proxy+}"
        }
      ],
      "stages": [
        {
          "autoDeploy": true,
          "defaultRouteSettings": {
            "DetailedMetricsEnabled": false
          },
          "routeSettings": {},
          "stage": "$default",
          "stageVariableNames": []
        }
      ]
    }
  },
  "lambdas": {
    "osrs-tracker_alarm-to-discord": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": "default (21600)",
      "asyncOnFailure": null,
      "asyncOnSuccess": null,
      "asyncRetries": "default (2)",
      "envVarNames": [
        "WEBHOOK_URL"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": null,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 10,
      "tracing": "PassThrough"
    },
    "osrs-tracker_clean-hiscores": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": "default (21600)",
      "asyncOnFailure": null,
      "asyncOnSuccess": null,
      "asyncRetries": 0,
      "envVarNames": [
        "MAX_AGE_IN_DAYS",
        "MONGODB_COLLECTION",
        "MONGODB_DATABASE",
        "MONGODB_URI",
        "WEBHOOK_URL"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": null,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 60,
      "tracing": "PassThrough"
    },
    "osrs-tracker_process-players": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": 3600,
      "asyncOnFailure": "osrs-tracker_players-to-scrape-dead",
      "asyncOnSuccess": null,
      "asyncRetries": 2,
      "envVarNames": [
        "MONGODB_COLLECTION",
        "MONGODB_DATABASE",
        "MONGODB_URI",
        "OSRS_API_BASE_URL",
        "PLAYERS_PER_EVENT",
        "WEBHOOK_URL"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": 5,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 60,
      "tracing": "PassThrough"
    },
    "osrs-tracker_queue-players": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": "default (21600)",
      "asyncOnFailure": null,
      "asyncOnSuccess": null,
      "asyncRetries": 0,
      "envVarNames": [
        "MONGODB_COLLECTION",
        "MONGODB_DATABASE",
        "MONGODB_URI",
        "PLAYERS_PER_EVENT",
        "PROCESS_PLAYERS_FUNCTION",
        "WEBHOOK_URL"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": null,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 30,
      "tracing": "PassThrough"
    },
    "osrs-tracker_record-player-count": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": "default (21600)",
      "asyncOnFailure": null,
      "asyncOnSuccess": null,
      "asyncRetries": 0,
      "envVarNames": [
        "MONGODB_COLLECTION",
        "MONGODB_DAILY_COLLECTION",
        "MONGODB_DATABASE",
        "MONGODB_URI",
        "WEBHOOK_URL"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": null,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 30,
      "tracing": "PassThrough"
    },
    "osrs-tracker_refresh-items": {
      "architectures": [
        "arm64"
      ],
      "asyncMaxEventAgeSeconds": "default (21600)",
      "asyncOnFailure": null,
      "asyncOnSuccess": null,
      "asyncRetries": "default (2)",
      "envVarNames": [
        "MONGODB_COLLECTION",
        "MONGODB_DATABASE",
        "MONGODB_URI"
      ],
      "ephemeralStorageMB": 512,
      "eventSourceMappings": [],
      "handler": "index.handler",
      "logFormat": "Text",
      "logRetentionDays": 7,
      "memoryMB": 256,
      "packageType": "Zip",
      "reservedConcurrency": null,
      "runtime": "nodejs24.x",
      "timeoutSeconds": 30,
      "tracing": "PassThrough"
    }
  },
  "queues": {
    "osrs-tracker_players-to-scrape-dead": {
      "delaySeconds": 0,
      "maxMessageBytes": 262144,
      "receiveWaitSeconds": 20,
      "redrive": null,
      "retentionSeconds": 604800,
      "sseManaged": true,
      "visibilityTimeoutSeconds": 30
    }
  },
  "region": "eu-central-1",
  "schedules": {
    "Hourly": {
      "eventBus": "default",
      "schedule": "cron(0 * * * ? *)",
      "state": "ENABLED",
      "targets": [
        "osrs-tracker_queue-players",
        "osrs-tracker_refresh-items"
      ]
    },
    "daily": {
      "eventBus": "default",
      "schedule": "cron(0 0 * * ? *)",
      "state": "ENABLED",
      "targets": [
        "osrs-tracker_clean-hiscores"
      ]
    },
    "osrs-tracker_record-player-count": {
      "eventBus": "default",
      "schedule": "rate(10 minutes)",
      "state": "ENABLED",
      "targets": [
        "osrs-tracker_record-player-count"
      ]
    }
  },
  "snsTopics": {
    "osrs-tracker-alerts": {
      "subscriptions": {
        "email": {
          "confirmed": 1,
          "filters": [
            {
              "policy": {
                "AlarmName": [
                  "osrs-tracker_alarm-to-discord-errors"
                ]
              },
              "scope": "MessageBody"
            }
          ],
          "pending": 0
        },
        "lambda": {
          "confirmed": 1,
          "filters": [],
          "pending": 0
        }
      }
    }
  }
}

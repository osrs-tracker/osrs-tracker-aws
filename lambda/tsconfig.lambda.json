{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "node",
    "lib": ["dom", "es2022"],
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "strict": true,
    // lambda/shared/ has no node_modules: its imports resolve from the Lambda being checked, and `@lambda/env` is that
    // Lambda's src/env.ts. build/esbuild.js in shared/ does the same for the bundle (nodePaths and alias)
    "paths": {
      "@lambda/env": ["${configDir}/src/env.ts"],
      "*": ["${configDir}/node_modules/*", "${configDir}/node_modules/@types/*"]
    }
  }
}

{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "lib": ["dom", "es2022"],
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "noUnusedLocals": true,
    "removeComments": true,
    "strict": true,
    // since TypeScript 6 no @types package is included unless listed (aws-lambda's are imported, not global)
    "types": ["node"],
    // specs: mongodb-memory-server's declarations import semver, which has no types here
    "skipLibCheck": true
  }
}

# Local-only settings for `npm run invoke:dry`; copy to `.env` and fill in. Never commit `.env`.
# Matches the schema in src/env.ts and the MongoDB variables every Lambda shares (../shared/src/env.ts), validated at
# cold start; only MONGODB_USERNAME/MONGODB_PASSWORD may be left empty, and only in production: locally they're
# required, or the driver tries MONGODB-AWS and fails with an auth error that doesn't name them. DRY_RUN (optional, default false) is set by
# `npm run invoke:dry` itself.
# MONGODB_USERNAME/MONGODB_PASSWORD: an Atlas database user (SCRAM). Production uses MONGODB-AWS instead.
# What each value is locally: see "Running a job locally" in the root README.
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=
MONGODB_USERNAME=
MONGODB_PASSWORD=

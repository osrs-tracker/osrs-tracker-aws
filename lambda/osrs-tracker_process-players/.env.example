# Local-only settings for `npm run invoke:dry`; copy to `.env` and fill in. Never commit `.env`.
# Matches the schema in src/env.ts and the MongoDB variables every Lambda shares (../shared/src/env.ts), validated at
# cold start; only MONGODB_USERNAME/MONGODB_PASSWORD may be left empty. DRY_RUN (optional, default false) is set by
# `npm run invoke:dry` itself.
# MONGODB_USERNAME/MONGODB_PASSWORD: an Atlas database user (SCRAM). Production uses MONGODB-AWS instead.
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=
MONGODB_USERNAME=
MONGODB_PASSWORD=
OSRS_API_BASE_URL=
PLAYERS_PER_SQS_MESSAGE=
SQS_QUEUE_URL=
WEBHOOK_URL=

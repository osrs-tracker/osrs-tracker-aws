# Local-only settings for `npm run invoke:dry`; copy to `.env` and fill in. Never commit `.env`.
# MONGODB_USERNAME/MONGODB_PASSWORD: an Atlas database user (SCRAM). Production uses MONGODB-AWS instead.
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=
MONGODB_USERNAME=
MONGODB_PASSWORD=
OSRS_API_BASE_URL=
PLAYERS_PER_SQS_MESSAGE=
SQS_QUEUE_URL=
WEBHOOK_URL=

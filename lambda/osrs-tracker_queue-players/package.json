{
  "name": "osrs-tracker_queue-players",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build": "node ./build/esbuild.js",
    "predeploy": "npm run build && cd dist && bestzip ../dist.zip * && cd ..",
    "deploy": "aws lambda update-function-code --function-name osrs-tracker_queue-players --zip-file fileb://dist.zip --publish",
    "postdeploy": "rm ./dist.zip",
    "update:runtime": "aws lambda update-function-configuration --function-name osrs-tracker_queue-players --runtime nodejs24.x",
    "lint": "eslint .",
    "prettier": "prettier --write .",
    "prettier:ci": "prettier --check .",
    "start": "node ./build/esbuild.js --dev --watch --run"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-conventional-changelog"
    }
  },
  "prettier": "./.prettierrc.json",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1145.0",
    "@aws-sdk/credential-providers": "^3.1145.0",
    "@osrs-tracker/discord-webhooks": "^0.0.2",
    "@osrs-tracker/models": "^0.7.1",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@es-exec/esbuild-plugin-start": "^0.0.5",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.1",
    "bestzip": "^2.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "minimist": "^1.2.8",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "engines": {
    "node": ">=24"
  }
}

{
  "name": "osrs-tracker_queue-players",
  "version": "0.0.1",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "prebuild": "rm -rf ./dist",
    "build": "node ../shared/build/esbuild.js",
    "predeploy": "npm run build && cd dist && bestzip ../dist.zip * && cd ..",
    "deploy": "aws lambda update-function-code --function-name osrs-tracker_queue-players --zip-file fileb://dist.zip --publish",
    "postdeploy": "rm ./dist.zip",
    "update:runtime": "aws lambda update-function-configuration --function-name osrs-tracker_queue-players --runtime nodejs24.x",
    "lint": "oxlint -c ../shared/.oxlintrc.json",
    "invoke:dry": "node ../shared/build/esbuild.js --dev && DRY_RUN=true node --env-file=.env ./build/invoke.js",
    "test": "vitest"
  },
  "prettier": "../../.prettierrc.json",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1145.0",
    "@aws-sdk/client-lambda": "^3.1145.0",
    "@aws-sdk/lib-dynamodb": "^3.1145.0",
    "@lambda/shared": "*",
    "@osrs-tracker/models": "^3.2.0",
    "envalid": "^8.2.0"
  },
  "engines": {
    "node": ">=24"
  }
}

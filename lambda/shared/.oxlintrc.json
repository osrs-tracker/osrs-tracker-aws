// The oxlint config of every Lambda and every @osrs-tracker package (each one's `lint` script passes it with -c) and of
// lambda/shared/ itself. process-players' `npm run lint` also lints lambda/shared/ (from lambda/: oxlint takes no `..`
// paths), so shared code is linted once; CI and the push hook run every Lambda's lint when shared code changes, and CI
// every package's when this file does.
//
// oxlint stands in for ESLint with typescript-eslint until typescript-eslint supports TypeScript 7 (#143): it parses
// TypeScript itself, with no `typescript` dependency. Only the rules the ESLint config had, so the way back changes
// nothing: oxlint's default `correctness` category is off, and ESLint's deprecated `no-return-await` has no oxlint
// equivalent.
// Formatting is Prettier's (the root .prettierrc.json): no rule here may overlap it. oxlint skips what .gitignore lists
// (dist/, node_modules).
{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "env": {
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-redeclare": "error",
    "prefer-const": "error"
  }
}

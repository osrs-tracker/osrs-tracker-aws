{
  "extends": "../tsconfig.lambda.json",
  "compilerOptions": {
    "typeRoots": ["node_modules/@types"],
    // vitest's declarations need `moduleResolution: bundler`, which the Lambdas' `paths` setup doesn't use
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}

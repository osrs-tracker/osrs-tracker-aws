# Local-only settings for `npm run invoke:dry`; copy to `.env` and fill in. Never commit `.env`.
# Matches the schema in src/env.ts, validated at cold start. This Lambda has no database, so no MongoDB variables.
# DRY_RUN (optional, default false) is set by `npm run invoke:dry` itself, which only logs the Discord message: any URL
# will do for WEBHOOK_URL.
WEBHOOK_URL=

# Copy to `.env` and fill in. Never commit `.env`; the script never prints these values.
# The same MongoDB values the Lambdas use locally (see "Running a job locally" in the root README).
# MONGODB_COLLECTION is the players collection; layouts always go to `hiscoreLayouts` in the same database.
# MONGODB_USERNAME/MONGODB_PASSWORD: an Atlas database user (SCRAM). Leave both empty for a local mongod without auth.
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION=
MONGODB_USERNAME=
MONGODB_PASSWORD=
